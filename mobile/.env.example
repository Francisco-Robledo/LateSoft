# URL base del Backend
# Para emulador Android en la misma maquina: http://10.0.2.2:3001
# Para dispositivo fisico en la misma red Wi-Fi: http://192.168.1.XX:3001
# Para produccion: https://api.latesoft.com.ar
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001

# OAuth Client IDs para Login Social
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id.apps.googleusercontent.com
EXPO_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id
EXPO_PUBLIC_GITHUB_CLIENT_ID=your_github_client_id

# Activa el selector flotante de perfiles en desarrollo (ADMIN, MANAGERS, CASHIER, BARISTA, CUSTOMER)
EXPO_PUBLIC_ENABLE_DEV_SWITCHER=true
